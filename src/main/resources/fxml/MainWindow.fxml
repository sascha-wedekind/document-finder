<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.materialicons.MaterialIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<?import atlantafx.base.controls.CustomTextField?>
<?import javafx.scene.control.Separator?>
<BorderPane fx:id="mainWindow" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
            minHeight="400.0" minWidth="480.0"
            prefHeight="480.0" prefWidth="528.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bytedompteur.documentfinder.ui.mainwindow.MainWindowController">
    <top>
        <VBox>
            <children>
                <MenuBar useSystemMenuBar="true">
                    <menus>
                        <Menu mnemonicParsing="false" text="Help">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#handleOpenLogDirectoryAction" text="Open log directory" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <HBox fx:id="mainWindowApplicationToolbar" spacing="5.0" BorderPane.alignment="CENTER">
                    <children>
                        <CustomTextField fx:id="searchTextField" minWidth="10.0" onAction="#handleSearchTextFieldAction"
                                         onKeyTyped="#searchAsYouType" promptText="text to search" HBox.hgrow="ALWAYS"
                                         styleClass="rounded">
                            <left>
                                <MaterialIconView glyphName="SEARCH" size="18"/>
                            </left>
                            <right>
                                <Button fx:id="clearSearchTextFieldButton" mnemonicParsing="false"
                                        onAction="#handleClearSearchTextButtonClick">
                                    <styleClass>
                                        <String fx:value="flat"/>
                                        <String fx:value="button-icon"/>
                                        <String fx:value="button-circle"/>
                                    </styleClass>
                                    <graphic>
                                        <MaterialIconView glyphName="DELETE" size="18"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Clear search result"/>
                                    </tooltip>
                                </Button>
                            </right>
                        </CustomTextField>
                        <Button fx:id="dateRangeFilterButton" mnemonicParsing="false"
                                onAction="#handleDateRangeFilterButtonClick" HBox.hgrow="NEVER">
                            <styleClass>
                                <String fx:value="flat"/>
                                <String fx:value="button-icon"/>
                                <String fx:value="button-circle"/>
                            </styleClass>
                            <graphic>
                                <MaterialIconView glyphName="DATE_RANGE" size="25"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Filter by last modified date"/>
                            </tooltip>
                        </Button>
                        <Button fx:id="findLastUpdatedButton" layoutX="432.0" layoutY="10.0" mnemonicParsing="false"
                                onAction="#handleFindLastUpdatedButtonClick">
                            <styleClass>
                                <String fx:value="flat"/>
                                <String fx:value="button-icon"/>
                                <String fx:value="button-circle"/>
                            </styleClass>
                            <graphic>
                                <MaterialIconView glyphName="HISTORY" size="25"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Last updated"/>
                            </tooltip>
                        </Button>
                        <Button fx:id="showOptionsButton" mnemonicParsing="false" onAction="#handleOptionsButtonClick"
                                HBox.hgrow="NEVER">
                            <styleClass>
                                <String fx:value="flat"/>
                                <String fx:value="button-icon"/>
                                <String fx:value="button-circle"/>
                            </styleClass>
                            <graphic>
                                <MaterialIconView glyphName="SETTINGS" size="25"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Settings"/>
                            </tooltip>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
                    </padding>
                </HBox>
                <HBox fx:id="mainWindowActiveFiltersBar" spacing="5.0" BorderPane.alignment="CENTER">
                    <children>
                        <Label fx:id="activeDateFilterChip" onMouseClicked="#handleActiveDateFilterChipClick"
                               managed="false" visible="false" contentDisplay="RIGHT" styleClass="rounded">
                            <graphic>
                                <MaterialIconView glyphName="CANCEL" size="14"/>
                            </graphic>
                        </Label>
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="0.0"/>
                    </padding>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <VBox fx:id="mainWindowApplicationCenterArea">
            <fx:include minHeight="10.0" minWidth="10.0" prefHeight="480.0" prefWidth="785.0"
                        source="SearchResultTable.fxml" fx:id="mainWindowResultTable" VBox.vgrow="ALWAYS">
            </fx:include>
            <VBox fx:id="mainWindowLittleHelpArea" alignment="CENTER" spacing="8.0" visible="false" managed="false" VBox.vgrow="ALWAYS">
                <children>
                    <MaterialIconView glyphName="SEARCH" size="64" styleClass="text-muted"/>
                    <Label styleClass="title-3" text="No results yet">
                        <VBox.margin>
                            <Insets top="8.0"/>
                        </VBox.margin>
                    </Label>
                    <Label styleClass="text-muted" text="Start typing to search, or set a date filter to browse by when files were last modified." textAlignment="CENTER" wrapText="true">
                        <maxWidth>320.0</maxWidth>
                    </Label>
                </children>
            </VBox>
            <padding>
                <Insets bottom="0.0" left="20.0" right="20.0" top="5.0"/>
            </padding>
        </VBox>
    </center>
    <padding>
        <Insets bottom="15.0" left="0.0" right="0.0" top="15.0"/>
    </padding>
    <bottom>
        <VBox>
            <children>
                <HBox fx:id="mainWindowApplicationStatusbar" minHeight="10.0" minWidth="10.0" translateY="10.0">
                    <fx:include source="ProgressBar.fxml" HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER">
                        <children>
                            <Label fx:id="numberOfSearchResultsLabel" text="2 search results">2 results</Label>
                        </children>
                    </VBox>
                </HBox>
            </children>
            <padding>
                <Insets bottom="0.0" left="20.0" right="20.0" top="0.0"/>
            </padding>
        </VBox>
    </bottom>
</BorderPane>
